{
  "theme_name": "Glass Layered",
  "version": "1.0",
  "platform": "Flutter / iOS / Android",
  "colors": {
    "graphite": "#171D22",
    "text_primary": "#27323A",
    "steel": "#68747C",
    "frost": "#E5EAED",
    "surface_white": "#FFFFFF",
    "signal_red": "#F52232",
    "waiting_amber": "#D99A42",
    "success_green": "#3C8D70",
    "border_light": "rgba(255,255,255,0.58)",
    "glass_fill_light": "rgba(255,255,255,0.72)",
    "glass_fill_dark": "rgba(34,43,50,0.72)"
  },
  "radii_logical_px": {
    "small": 10,
    "input": 14,
    "card": 20,
    "large_card": 24,
    "pill": 28,
    "modal": 28
  },
  "spacing_4pt_scale": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "typography": {
    "font_primary": "Inter or Manrope",
    "font_mono": "IBM Plex Mono",
    "screen_title": {
      "size": 26,
      "weight": 600,
      "line_height": 32
    },
    "section_title": {
      "size": 19,
      "weight": 600,
      "line_height": 24
    },
    "card_title": {
      "size": 17,
      "weight": 600,
      "line_height": 22
    },
    "body": {
      "size": 15,
      "weight": 400,
      "line_height": 22
    },
    "secondary": {
      "size": 13,
      "weight": 400,
      "line_height": 18
    },
    "micro_label": {
      "size": 11,
      "weight": 500,
      "line_height": 14
    }
  },
  "glass": {
    "light_fill_opacity_range": [
      0.65,
      0.85
    ],
    "default_card_fill_opacity": 0.72,
    "blur_sigma_range": [
      8,
      16
    ],
    "default_blur_sigma": 12,
    "border_width": 1,
    "border_color": "rgba(255,255,255,0.58)",
    "shadow_color": "rgba(23,29,34,0.10)",
    "shadow_blur": 18,
    "shadow_offset_y": 6
  },
  "accessibility": {
    "minimum_touch_target_logical_px": 48,
    "support_text_scaling": true,
    "provide_reduced_transparency_mode": true,
    "provide_reduced_motion_mode": true,
    "never_place_essential_text_over_busy_background": true
  }
}